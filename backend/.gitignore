# ==============================================================================
# Git Ignore - VisualGuard AI Backend
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
.venv/
env/
venv/
ENV/

# Environment Variables & Secrets (CRITICAL: Never commit secrets)
.env
.env.*
!.env.example

# Media Storage Directories (Track directory with .gitkeep, ignore files)
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# IDEs & Editors
.vscode/
.idea/
*.swp
*.swo
# Virtual environments
.venv/
venv/
backend/.venv/

# Environment variables and secrets
.env
.env.*

# Python cache
__pycache__/
*.py[cod]
.pytest_cache/

# IDE
.vscode/
.idea/

# Generated files
backend/uploads/*
backend/outputs/*

# Keep empty directories
!backend/uploads/.gitkeep
!backend/outputs/.gitkeep
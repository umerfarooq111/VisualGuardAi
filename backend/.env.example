# ==============================================================================
# VisualGuard AI - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the backend directory and adjust the values:
#   cp .env.example .env   (Linux/macOS)
#   copy .env.example .env (Windows cmd)
#
# DO NOT commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="VisualGuard AI Backend"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Server Networking
HOST="127.0.0.1"
PORT=8000

# Database Connection (Placeholder only - No active connection in this phase)
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/visualguard_db"

# Storage Directories (Relative to the 'backend' directory or absolute paths)
UPLOAD_DIR="uploads"
OUTPUT_DIR="outputs"
